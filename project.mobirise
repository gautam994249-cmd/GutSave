          "_name": "article04",
          "_sourceTheme": "legalm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article04 legalm5\" group=\"Article\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Text 1\" name=\"showText_1\">\n        <input type=\"checkbox\" title=\"Text 2\" name=\"showText_2\">\n        <input type=\"checkbox\" title=\"List\" name=\"showList\" checked>\n        <input type=\"checkbox\" title=\"List Title\" name=\"showListTitle\" condition=\"showList\">\n        <input type=\"color\" title=\"Marker Color\" value=\"#9fe870\" name=\"marker\" condition=\"showList\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f1f1f1\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 col-lg-7\">\n                <div class=\"content-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">\n                        About the Attorney Firm\n                    </h2>\n                    <p class=\"mbr-text_1 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text_1\" mbr-if=\"showText_1\">\n                        Attorneys provide clients with legal advice and guidance on a wide range of issues. They help\n                        clients understand their rights and responsibilities under the law, as well as the potential\n                        legal implications of their actions. Clients often seek legal counsel when making important\n                        decisions or facing legal challenges.\n                    </p>\n                    <div class=\"list-wrapper\" mbr-if=\"showList\">\n                        <h3 class=\"mbr-list-title  mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showListTitle\" data-app-selector=\".mbr-list-title\"></h3>\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                            <li class=\"item-wrap\">Natural Formula\n</li><li class=\"item-wrap\">East To Use\n</li><li class=\"item-wrap\">Non-GMO</li>\n                            <li class=\"item-wrap\">No Stimulants\n</li><li class=\"item-wrap\">Non-Habit Forming\n</li><li class=\"item-wrap\">Gluten Free</li>\n                        </ul>\n                    </div>\n                    <p class=\"mbr-text_2 mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text_2\" mbr-if=\"showText_2\">\n                        These are just some of the many functions that attorney firms perform to serve the legal needs\n                        of their clients and ensure that justice is upheld within the legal system. The specific areas\n                        of expertise and services offered can vary widely depending on the type and size of the firm.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "article04-y",
